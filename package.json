{
  "name": "burrow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@biomejs/biome",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:node": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:better-sqlite3 && node dist/server.cjs",
    "build": "vite build",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "node scripts/check.mjs",
    "check:data": "node scripts/check-data.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply burrow --local",
    "db:migrate:remote": "wrangler d1 migrations apply burrow --remote",
    "seed:local": "node scripts/seed.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "logs": "wrangler tail",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/shadcn": "^0.55.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "better-auth": "^1.7.5",
    "better-sqlite3": "12.4.1",
    "canvas-confetti": "^1.9.4",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.8",
    "jose": "latest",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  }
}
