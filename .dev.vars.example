# Optional overrides for local development (git-ignored).
# `pnpm dev` and `pnpm run setup` work out-of-the-box without creating this file
# and output all credentials and IDs directly to the console.
D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=

# WARNING: NEVER use default secrets in production!
# For production deployments, generate cryptographically secure secrets using:
#   openssl rand -base64 32
# In production:
#   BETTER_AUTH_SECRET must be at least 32 characters.
#   BOOTSTRAP_TOKEN must be at least 16 characters.
BETTER_AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!
BETTER_AUTH_URL=http://localhost:3005
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Storage Configuration
# Local disk storage (used when R2 / S3 bindings are absent):
# LOCAL_STORAGE_PATH=./data/uploads

# S3-compatible object storage (optional):
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=burrow-files
# S3_ACCESS_KEY=your-access-key-id
# S3_SECRET_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=false

