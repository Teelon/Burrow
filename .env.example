# Optional environment overrides for local development or custom scripts.
# All setup and dev commands work out-of-the-box without a .env or .dev.vars file
# and print active credentials/resource IDs directly to the console.

# Cloudflare Configuration (optional — auto-discovered by scripts via Wrangler)
D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=

# Application Secrets (optional locally — defaults are injected automatically by `pnpm dev`)
BETTER_AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!
BETTER_AUTH_URL=http://localhost:3005
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Email (optional — without these, invite emails are logged to console)
# Sign up at https://resend.com, verify your sending domain (SPF/DKIM)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Burrow <notify@yourdomain.com>
