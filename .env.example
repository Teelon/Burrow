# Copy to .env or .dev.vars (git-ignored)
# Never commit real credentials or database IDs to version control.

# Cloudflare Configuration (optional for local dev, used during remote deployment)
D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=

# Application Secrets
BETTER_AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!
BETTER_AUTH_URL=http://localhost:5173
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Email (optional — without these, invite emails are logged to console)
# Sign up at https://resend.com, verify your sending domain (SPF/DKIM)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Burrow <notify@yourdomain.com>
