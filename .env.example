# Optional environment overrides for local development or custom scripts.
# All setup and dev commands work out-of-the-box without a .env or .dev.vars file
# and print active credentials/resource IDs directly to the console.

# Cloudflare Configuration (optional — auto-discovered by scripts via Wrangler)
D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=

# Application Secrets (optional locally — defaults are injected automatically by `pnpm dev`)
# WARNING: NEVER use default secrets in production!
# For production deployments, generate cryptographically secure secrets using:
#   openssl rand -base64 32
# In production:
#   BETTER_AUTH_SECRET must be at least 32 characters.
#   BOOTSTRAP_TOKEN must be at least 16 characters.
BETTER_AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!
BETTER_AUTH_URL=http://localhost:3005
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Email (optional — without these, invite emails are logged to console)
# Sign up at https://resend.com, verify your sending domain (SPF/DKIM)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Burrow <notify@yourdomain.com>

# Storage Configuration
# Local disk storage (used by default in Node server when R2 or S3 is not configured):
# LOCAL_STORAGE_PATH=./data/uploads

# S3 / MinIO / Tigris Object Storage (optional — alternative to Cloudflare R2 or local storage):
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=burrow-files
# S3_ACCESS_KEY=your-access-key-id
# S3_SECRET_KEY=your-secret-access-key
# S3_FORCE_PATH_STYLE=false
